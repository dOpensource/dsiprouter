{
  "name": "dsiprouter-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "E2E tests for dSIPRouter using Playwright",
  "scripts": {
    "test": "npx playwright test",
    "test:login": "npx playwright test login",
    "test:users-crud": "npx playwright test users-crud",
    "test:rbac": "npx playwright test rbac",
    "test:password-visibility": "npx playwright test password-visibility",
    "test:users-api": "npx playwright test users-api",
    "test:domains": "npx playwright test domains-",
    "test:cdr": "npx playwright test cdr-",
    "test:full": "DSIP_TEST_SHELL=1 npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "install:browsers": "npx playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
