#!/usr/bin/env bash
#
# Summary:  Create a changelog on commit
# Author:   DevOpSec <https://github.com/devopsec>
# Notes:    Original idea from Martin Seeler <https://github.com/MartinSeeler>
# Usage:    Copy to your repo in <repo>/.git/hooks/post-commit
#           Alternatively the functions can be run outside of git (using -exec option)
# Notes:    Syntax for markdown comment: [//]: # (...)
#           All sections in the changelog are tagged within markdown comments
# TODO:     Support resolving gitlab url's for merges/issues/commits
#


# unshadow git command
unset -f git
# project root
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
# destination changelog file
CHANGELOG_FILE="CHANGELOG.md"
# tags that mark a release, the commits in the changelog are grouped by the release they were first part of
RELEASE_TAG_PATTERN="${RELEASE_TAG_PATTERN:-v[0-9]*-rel}"
# title of our changelog
CHANGELOG_TITLE="CHANGELOG"
# indicator that we commited the changelog
CHANGELOG_INDICATOR_FILE="${PROJECT_ROOT}/.changelog_commited"
# indicator that post commit hooks have been disabled
DISABLED_INDICATOR_FILE="${PROJECT_ROOT}/.postcommit_disabled"
# should be exported by git wrapper script
REMOTE_NAME="${REMOTE_NAME:-origin}"
# file that will hold remote that must be pushed to
REMOTE_FILE="${PROJECT_ROOT}/.push_remote"
# remote info used in script
export REMOTE_URL=$(git remote get-url ${REMOTE_NAME} 2>/dev/null | perl -pe 's%(?:git\@|https\://).+?@(.+)(?:\:|/)(.+)/(.+)\.git%https://\1/\2/\3%')
export REMOTE_SITE=$(cut -d '/' -f -3 <<<"${REMOTE_URL}")
export REMOTE_USER=$(cut -d '/' -f 4 <<<"${REMOTE_URL}")
export REMOTE_REPO=$(cut -d '/' -f 5- <<<"${REMOTE_URL}")


# utility functions
isRemoteGitlab() {
    # the well known sites are not requested on every commit
    case "$REMOTE_SITE" in
        *github.com*)
            return 1
            ;;
        *gitlab.com*)
            return 0
            ;;
    esac
    curl -L ${REMOTE_URL} 2>/dev/null | grep -q -ioP '<title>.*?gitlab</title>'
    return $?
}

createMDRenderedSection() {
    local NAME="$1"
    local CONTENT="$2"

    printf '%s\n' "[//]: # (START_SECTION ${NAME})"
    printf '%s' "$CONTENT" | sed -e '$a\'
    printf '%s\n' "[//]: # (END_SECTION ${NAME})"
}
export -f createMDRenderedSection

createMDCommentSection() {
    local NAME="$1"
    local CONTENT="$2"

    printf '%s\n' "[//]: # (START_SECTION ${NAME}"
    printf '%s' "$CONTENT" | sed -e '$a\'
    printf '%s\n' "END_SECTION ${NAME})"
}
export -f createMDCommentSection

getMDRenderedSection() {
    local NAME="$1"

    perl -e "\$name='${NAME}';" -0777 \
        -e ' while (<>) { if (s%.*\[//\]: # \(START_SECTION ${name}\)\n(.*?)\[//\]: # \(END_SECTION ${name}\)\n.*%\1%s) { print; } }'
}
export -f getMDRenderedSection

# create a formatted commit section
createCommitSection() {
    local HASH="$1" CONTENT="" OIFS=$IFS
    local PULL_OR_MERGE=${PULL_OR_MERGE:-pull}

    IFS= read -rd '' CONTENT < <(
        # format commit header
        git --no-pager log -n 1 --format='### %s%n%N%n%N> Commit: %H  %n%N> Date: %aD  %n%N> Author: %aN (%aE)  %n%N> Committer: %cN (%cE)  %n%N> Signed: %GS  %n%N%n%N' ${HASH} 2>/dev/null |
        perl -e "\$rs='${REMOTE_SITE}'; \$ru='${REMOTE_USER}'; \$rr='${REMOTE_REPO}';" \
            -pe 's%([0-9a-f]{40})(?!\w)%[\1](${rs}/${ru}/${rr}/commit/\1)%m'
        # format commit body
        git log --format='%b' -n 1 ${HASH} 2>/dev/null |
        # format issues/pulls/commits -> links
        # delete empty lines, lines -> bullets
        perl -e "\$rs='${REMOTE_SITE}'; \$ru='${REMOTE_USER}'; \$rr='${REMOTE_REPO}';" \
            -pe 's%(${rs}/${ru}/${rr}/'"$PULL_OR_MERGE"'/)(\d+)%[#\2](\1\2)%gm;
            s%(${rs}/${ru}/${rr}/issues/)(\d+)%[#\2](\1\2)%gm;
            s%(${rs}/${ru}/${rr}/commit/)([0-9a-f]{7})([0-9a-f]{0,33})(?!\w)%[\2](\1\2\3)%gm;
            s%^\s+?$%%; s%^(?:[ \t]+(?:- )?)?([^\s])%- \1%gm;'
        # spacing between commit messages
        printf '\n\n%s\n\n' '---'
    )
    createMDRenderedSection "$HASH" "$CONTENT"
    IFS=$OIFS
}
export -f createCommitSection

# print the names of the rendered commit sections in a changelog, in the order they appear
getMDCommitSectionNames() {
    sed -n 's%^\[//\]: # (START_SECTION \([0-9a-f]\{40\}\))$%\1%p'
}
export -f getMDCommitSectionNames

# list the commits of HEAD grouped by the release they were first part of
# output:   "R <tag> <date>" for each release (newest first) followed by "C <hash>" for each of its commits (git log order)
#           commits that are not part of a release yet are listed first, after the line "U"
# notes:    a release is a tag matching RELEASE_TAG_PATTERN, releases are ordered by the version number in the tag
#           without release tags only the commits are listed
createChangelogLayout() {
    local TAG
    local -a TAGS

    mapfile -t TAGS < <(
        git tag -l "$RELEASE_TAG_PATTERN" |
        perl -ne 'chomp; print "$1 $_\n" if /(\d+(?:\.\d+)?)/' |
        sort -g -k1,1 |
        cut -d ' ' -f 2-
    )

    {
        git for-each-ref --format='D %(refname:short) %(creatordate:short)' refs/tags
        # oldest release first, a commit belongs to the first release that contains it
        for TAG in "${TAGS[@]}"; do
            git rev-list --no-merges "$TAG" | sed "s%^%T ${TAG} %"
        done
        git rev-list --no-merges HEAD | sed 's%^%H %'
    } | awk '
        $1 == "D" { date[$2] = $3; next }
        $1 == "T" {
            if (!($2 in known)) { known[$2] = 1; tags[++ntags] = $2 }
            if (!($3 in release)) release[$3] = $2
            next
        }
        $1 == "H" {
            tag = ($2 in release) ? release[$2] : ""
            commits[tag] = commits[tag] "C " $2 "\n"
        }
        END {
            if ("" in commits) {
                if (ntags > 0) print "U"
                printf "%s", commits[""]
            }
            for (i = ntags; i >= 1; i--) {
                if (tags[i] in commits) {
                    print "R " tags[i] " " date[tags[i]]
                    printf "%s", commits[tags[i]]
                }
            }
        }'
}

# write the sections of a changelog in the order of a layout
# usage:    createChangelogSections <layout file> <dir with new commit sections> <existing changelog>
# notes:    the section of a commit is taken from the existing changelog if it has one, otherwise from the file named after the commit
createChangelogSections() {
    awk -v layout="$1" -v sections_dir="$2" '
        function heading(name, title, date) {
            print start name ")"
            print title
            print ""
            if (date != "") {
                print "> Released: " date "  "
                print ""
            }
            print ""
            print stop name ")"
        }
        BEGIN {
            start = "[//]: # (START_SECTION "
            stop = "[//]: # (END_SECTION "
        }
        current == "" {
            if (substr($0, 1, length(start)) == start && length($0) == length(start) + 41) {
                name = substr($0, length(start) + 1, 40)
                if (name ~ /^[0-9a-f]+$/) {
                    current = name
                    text = $0 "\n"
                }
            }
            next
        }
        {
            text = text $0 "\n"
            if ($0 == stop current ")") {
                section[current] = text
                current = ""
            }
        }
        END {
            while ((getline line < layout) > 0) {
                split(line, field, " ")
                if (field[1] == "C") {
                    if (field[2] in section) {
                        printf "%s", section[field[2]]
                    } else {
                        file = sections_dir "/" field[2]
                        while ((getline text < file) > 0) print text
                        close(file)
                    }
                } else if (field[1] == "U") {
                    heading("UNRELEASED", "## Unreleased", "")
                } else if (field[1] == "R") {
                    heading("RELEASE " field[2], "## " field[2], field[3])
                }
            }
        }' "$3"
}

# create or update the changelog file
# notes:    a section is only created for the commits the changelog does not have yet, the other sections are reused as they are
#           the sections of commits that are no longer part of HEAD are dropped
#           the changelog is written to a temporary file first, it is read while the new one is created
createChangelog() {
    local HEADER WORK_DIR RETVAL JOBS
    local EXISTING_CHANGELOG="/dev/null"

    JOBS=$(nproc 2>/dev/null || echo 4)

    # start at project root
    cd ${PROJECT_ROOT}

    # if gitlab we use merges if github we use pulls
    if isRemoteGitlab; then
        export PULL_OR_MERGE="merge_requests"
    else
        export PULL_OR_MERGE="pull"
    fi

    WORK_DIR=$(mktemp -d) || return 1
    mkdir -p "${WORK_DIR}/sections"

    git --no-pager log --no-merges --format='%H' >"${WORK_DIR}/commits"
    createChangelogLayout >"${WORK_DIR}/layout"
    : >"${WORK_DIR}/existing"
    if [[ -e "$CHANGELOG_FILE" ]]; then
        EXISTING_CHANGELOG="$CHANGELOG_FILE"
        getMDCommitSectionNames <"$CHANGELOG_FILE" >"${WORK_DIR}/existing"
    fi

    # one file per new commit, so the sections can be created in parallel and still be written in order
    grep -vxFf "${WORK_DIR}/existing" "${WORK_DIR}/commits" >"${WORK_DIR}/added"
    xargs -r -P "$JOBS" -I '{}' bash -c 'createCommitSection "$1" >"$2/$1"' _ '{}' "${WORK_DIR}/sections" <"${WORK_DIR}/added"
    RETVAL=$?

    if (( $RETVAL == 0 )); then
        printf -v HEADER '%s\n\n\n\n' "## $CHANGELOG_TITLE"
        {
            createMDRenderedSection 'HEADER' "$HEADER" &&
            createMDCommentSection 'COMMITS' "$(<"${WORK_DIR}/commits")" &&
            createChangelogSections "${WORK_DIR}/layout" "${WORK_DIR}/sections" "$EXISTING_CHANGELOG"
        } >"${WORK_DIR}/changelog" &&
        cat "${WORK_DIR}/changelog" >"$CHANGELOG_FILE"
        RETVAL=$?
    fi

    rm -rf "$WORK_DIR"
    return $RETVAL
}

main() {
    touch ${CHANGELOG_INDICATOR_FILE}
    createChangelog &&
    git add ${CHANGELOG_FILE} &&
    git commit --amend -C HEAD --no-verify &&
    echo "$REMOTE_NAME" > ${REMOTE_FILE} &&
    exit 0 ||
    exit 1
}

# allow execution outside of git hook
if (( $# > 0 )) && [[ "$1" == "-exec" ]]; then
    main
fi

# don't run if hook is disabled
# this is primarily for conflict resolution
if [[ -e ${DISABLED_INDICATOR_FILE} ]]; then
    rm -f ${DISABLED_INDICATOR_FILE}
    exit 0
# prevent recursion
# since a 'commit --amend' will trigger the post-commit script again
# we have to check if the changelog file has been commited yet
# if changelog commited this is recursive call, do nothing
elif [[ -e ${CHANGELOG_INDICATOR_FILE} ]]; then
    rm -f ${CHANGELOG_INDICATOR_FILE}
    exit 0
else
    main
fi
